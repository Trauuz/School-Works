<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23094" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="navigationController">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies><plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23084"/><capability name="Safe area layout guides" minToolsVersion="9.0"/><capability name="System colors in document resources" minToolsVersion="11.0"/></dependencies>
    <scenes>
        <scene sceneID="navigationScene"><objects>
            <navigationController automaticallyAdjustsScrollViewInsets="NO" id="navigationController" sceneMemberID="viewController">
                <navigationBar key="navigationBar" contentMode="scaleToFill" id="navigationBar"><rect key="frame" x="0.0" y="0.0" width="0.0" height="44"/><autoresizingMask key="autoresizingMask"/><color key="barTintColor" systemColor="systemBackgroundColor"/></navigationBar>
                <connections><segue destination="welcomeController" kind="relationship" relationship="rootViewController" id="rootRelationship"/></connections>
            </navigationController>
            <placeholder placeholderIdentifier="IBFirstResponder" id="navResponder" userLabel="First Responder" sceneMemberID="firstResponder"/>
        </objects><point key="canvasLocation" x="-850" y="0.0"/></scene>
        <scene sceneID="welcomeScene"><objects>
            <viewController id="welcomeController" customClass="ViewController" customModule="CampusCompanion" customModuleProvider="target" sceneMemberID="viewController">
                <view key="view" contentMode="scaleToFill" id="welcomeView"><rect key="frame" x="0.0" y="0.0" width="393" height="852"/><autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <subviews>
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Campus Companion" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="titleLabel"><fontDescription key="fontDescription" type="boldSystem" pointSize="28"/><color key="textColor" systemColor="labelColor"/></label>
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Your Campus, In Your Pocket" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="subtitleLabel"><fontDescription key="fontDescription" type="system" pointSize="16"/><color key="textColor" systemColor="secondaryLabelColor"/></label>
                        <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO" id="campusImageView"><color key="tintColor" systemColor="systemBlueColor"/></imageView>
                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="getStartedButton"><state key="normal" title="Get Started"/><connections><action selector="getStartedTapped:" destination="welcomeController" eventType="touchUpInside" id="getStartedAction"/></connections></button>
                        <textField opaque="NO" contentMode="scaleToFill" borderStyle="roundedRect" placeholder="Enter your name" textAlignment="natural" minimumFontSize="17" translatesAutoresizingMaskIntoConstraints="NO" id="nameTextField"><fontDescription key="fontDescription" type="system" pointSize="17"/></textField>
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Notify me about events" translatesAutoresizingMaskIntoConstraints="NO" id="notifyLabel"><fontDescription key="fontDescription" type="system" pointSize="16"/></label>
                        <switch opaque="NO" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="notifySwitch"/>
                        <segmentedControl opaque="NO" contentMode="scaleToFill" selectedSegmentIndex="0" translatesAutoresizingMaskIntoConstraints="NO" id="roleSegmentedControl"><segments><segment title="Student"/><segment title="Faculty"/></segments></segmentedControl>
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Preferred Event Date" translatesAutoresizingMaskIntoConstraints="NO" id="dateLabel"><fontDescription key="fontDescription" type="system" pointSize="16"/></label>
                        <datePicker opaque="NO" contentMode="scaleToFill" datePickerMode="date" translatesAutoresizingMaskIntoConstraints="NO" id="eventDatePicker"/>
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Guests: 0" translatesAutoresizingMaskIntoConstraints="NO" id="guestsLabel"><fontDescription key="fontDescription" type="system" pointSize="16"/></label>
                        <stepper opaque="NO" contentMode="scaleToFill" value="0.0" minimumValue="0.0" maximumValue="10" translatesAutoresizingMaskIntoConstraints="NO" id="guestsStepper"><connections><action selector="guestsStepperChanged:" destination="welcomeController" eventType="valueChanged" id="stepperAction"/></connections></stepper>
                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="exploreButton"><state key="normal" title="Explore Campus"/><connections><action selector="exploreButtonTapped:" destination="welcomeController" eventType="touchUpInside" id="exploreAction"/></connections></button>
                    </subviews>
                    <viewLayoutGuide key="safeArea" id="welcomeSafeArea"/><color key="backgroundColor" systemColor="systemBackgroundColor"/>
                    <constraints>
                        <constraint firstItem="titleLabel" firstAttribute="top" secondItem="welcomeSafeArea" secondAttribute="top" constant="16" id="titleTop"/><constraint firstItem="titleLabel" firstAttribute="leading" secondItem="welcomeSafeArea" secondAttribute="leading" constant="20" id="titleLeading"/><constraint firstItem="welcomeSafeArea" firstAttribute="trailing" secondItem="titleLabel" secondAttribute="trailing" constant="20" id="titleTrailing"/>
                        <constraint firstItem="subtitleLabel" firstAttribute="top" secondItem="titleLabel" secondAttribute="bottom" constant="8" id="subtitleTop"/><constraint firstItem="subtitleLabel" firstAttribute="leading" secondItem="welcomeSafeArea" secondAttribute="leading" constant="20" id="subtitleLeading"/><constraint firstItem="welcomeSafeArea" firstAttribute="trailing" secondItem="subtitleLabel" secondAttribute="trailing" constant="20" id="subtitleTrailing"/>
                        <constraint firstItem="campusImageView" firstAttribute="top" secondItem="subtitleLabel" secondAttribute="bottom" constant="12" id="imageTop"/><constraint firstItem="campusImageView" firstAttribute="centerX" secondItem="welcomeSafeArea" secondAttribute="centerX" id="imageCenter"/><constraint firstItem="campusImageView" firstAttribute="width" constant="100" id="imageWidth"/><constraint firstItem="campusImageView" firstAttribute="height" constant="100" id="imageHeight"/>
                        <constraint firstItem="getStartedButton" firstAttribute="top" secondItem="campusImageView" secondAttribute="bottom" constant="8" id="startTop"/><constraint firstItem="getStartedButton" firstAttribute="centerX" secondItem="welcomeSafeArea" secondAttribute="centerX" id="startCenter"/>
                        <constraint firstItem="nameTextField" firstAttribute="top" secondItem="getStartedButton" secondAttribute="bottom" constant="16" id="nameTop"/><constraint firstItem="nameTextField" firstAttribute="leading" secondItem="welcomeSafeArea" secondAttribute="leading" constant="32" id="nameLeading"/><constraint firstItem="welcomeSafeArea" firstAttribute="trailing" secondItem="nameTextField" secondAttribute="trailing" constant="32" id="nameTrailing"/>
                        <constraint firstItem="notifyLabel" firstAttribute="top" secondItem="nameTextField" secondAttribute="bottom" constant="16" id="notifyTop"/><constraint firstItem="notifyLabel" firstAttribute="leading" secondItem="welcomeSafeArea" secondAttribute="leading" constant="32" id="notifyLeading"/><constraint firstItem="notifySwitch" firstAttribute="centerY" secondItem="notifyLabel" secondAttribute="centerY" id="switchCenterY"/><constraint firstItem="welcomeSafeArea" firstAttribute="trailing" secondItem="notifySwitch" secondAttribute="trailing" constant="32" id="switchTrailing"/>
                        <constraint firstItem="roleSegmentedControl" firstAttribute="top" secondItem="notifyLabel" secondAttribute="bottom" constant="16" id="roleTop"/><constraint firstItem="roleSegmentedControl" firstAttribute="leading" secondItem="welcomeSafeArea" secondAttribute="leading" constant="32" id="roleLeading"/><constraint firstItem="welcomeSafeArea" firstAttribute="trailing" secondItem="roleSegmentedControl" secondAttribute="trailing" constant="32" id="roleTrailing"/>
                        <constraint firstItem="dateLabel" firstAttribute="top" secondItem="roleSegmentedControl" secondAttribute="bottom" constant="16" id="dateLabelTop"/><constraint firstItem="dateLabel" firstAttribute="leading" secondItem="welcomeSafeArea" secondAttribute="leading" constant="32" id="dateLabelLeading"/><constraint firstItem="eventDatePicker" firstAttribute="top" secondItem="dateLabel" secondAttribute="bottom" constant="4" id="datePickerTop"/><constraint firstItem="eventDatePicker" firstAttribute="centerX" secondItem="welcomeSafeArea" secondAttribute="centerX" id="datePickerCenter"/>
                        <constraint firstItem="guestsLabel" firstAttribute="top" secondItem="eventDatePicker" secondAttribute="bottom" constant="8" id="guestsTop"/><constraint firstItem="guestsLabel" firstAttribute="leading" secondItem="welcomeSafeArea" secondAttribute="leading" constant="32" id="guestsLeading"/><constraint firstItem="guestsStepper" firstAttribute="centerY" secondItem="guestsLabel" secondAttribute="centerY" id="stepperCenterY"/><constraint firstItem="welcomeSafeArea" firstAttribute="trailing" secondItem="guestsStepper" secondAttribute="trailing" constant="32" id="stepperTrailing"/>
                        <constraint firstItem="exploreButton" firstAttribute="top" secondItem="guestsLabel" secondAttribute="bottom" constant="20" id="exploreTop"/><constraint firstItem="exploreButton" firstAttribute="centerX" secondItem="welcomeSafeArea" secondAttribute="centerX" id="exploreCenter"/>
                    </constraints>
                </view>
                <navigationItem key="navigationItem" title="Campus Companion" id="welcomeNavigationItem"/>
                <connections><outlet property="campusImageView" destination="campusImageView" id="imageOutlet"/><outlet property="eventDatePicker" destination="eventDatePicker" id="dateOutlet"/><outlet property="guestsLabel" destination="guestsLabel" id="guestsLabelOutlet"/><outlet property="guestsStepper" destination="guestsStepper" id="stepperOutlet"/><outlet property="nameTextField" destination="nameTextField" id="nameOutlet"/><outlet property="notifySwitch" destination="notifySwitch" id="switchOutlet"/><outlet property="roleSegmentedControl" destination="roleSegmentedControl" id="roleOutlet"/><outlet property="subtitleLabel" destination="subtitleLabel" id="subtitleOutlet"/><outlet property="titleLabel" destination="titleLabel" id="titleOutlet"/><segue destination="detailController" kind="show" identifier="ShowDetailSegue" id="detailSegue"/></connections>
            </viewController>
            <placeholder placeholderIdentifier="IBFirstResponder" id="welcomeResponder" userLabel="First Responder" sceneMemberID="firstResponder"/>
        </objects><point key="canvasLocation" x="0.0" y="0.0"/></scene>
        <scene sceneID="detailScene"><objects>
            <viewController id="detailController" customClass="DetailViewController" customModule="CampusCompanion" customModuleProvider="target" sceneMemberID="viewController">
                <view key="view" contentMode="scaleToFill" id="detailView"><rect key="frame" x="0.0" y="0.0" width="393" height="852"/><autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/><subviews><label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Campus Events" textAlignment="center" lineBreakMode="wordWrap" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="messageLabel"><fontDescription key="fontDescription" type="system" pointSize="19"/><color key="textColor" systemColor="labelColor"/></label></subviews><viewLayoutGuide key="safeArea" id="detailSafeArea"/><color key="backgroundColor" systemColor="systemBackgroundColor"/><constraints><constraint firstItem="messageLabel" firstAttribute="leading" secondItem="detailSafeArea" secondAttribute="leading" constant="32" id="messageLeading"/><constraint firstItem="detailSafeArea" firstAttribute="trailing" secondItem="messageLabel" secondAttribute="trailing" constant="32" id="messageTrailing"/><constraint firstItem="messageLabel" firstAttribute="centerY" secondItem="detailSafeArea" secondAttribute="centerY" id="messageCenterY"/></constraints></view>
                <navigationItem key="navigationItem" title="Campus Events" id="detailNavigationItem"/><connections><outlet property="messageLabel" destination="messageLabel" id="messageOutlet"/></connections>
            </viewController>
            <placeholder placeholderIdentifier="IBFirstResponder" id="detailResponder" userLabel="First Responder" sceneMemberID="firstResponder"/>
        </objects><point key="canvasLocation" x="900" y="0.0"/></scene>
    </scenes>
    <resources><systemColor name="labelColor"><color white="0.0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/></systemColor><systemColor name="secondaryLabelColor"><color red="0.2352941176" green="0.2352941176" blue="0.262745098" alpha="0.6" colorSpace="custom" customColorSpace="sRGB"/></systemColor><systemColor name="systemBackgroundColor"><color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/></systemColor><systemColor name="systemBlueColor"><color red="0.0" green="0.4784313725" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/></systemColor></resources>
</document>
